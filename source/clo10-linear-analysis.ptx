    </image>
  </figure>
  <p>
    Then, <xref ref="figure-residual-plot-2"/> is the matching
    residual plot. 
  </p>
  <figure xml:id="figure-residual-plot-2">
    <caption>The associated residual plot</caption>
    <image xml:id="image-residual-plot-2" width="80%">
      <latex-image>
        \begin{tikzpicture}
          \begin{axis}[
            xlabel={x},
            ylabel={y},
            ]
            \addplot+ [only marks] table[
              x=var1,
              y=residual,
              col sep=comma,
              row sep=crcr 
            ] {
              var1,residual\\
              2,0.2\\
              3,0.5\\
              5,-0.8\\
              8,-1\\
              11,0.3\\
              15,-0.8\\
              16,-1.3\\
