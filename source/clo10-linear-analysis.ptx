\begin{frame}
  \frametitle{$R^2$ values}
  \begin{itemize}
    \item[] $r =$ correlation.
      \vspace{0.5cm}
    \item[] $R^2 = r^2 = $ correlation squared. 
      \vspace{0.5cm}
    \item[] $R^2 \in [0,1]$. 
      \vspace{0.5cm}
    \item[] Adjusted $R^2$.
  \end{itemize}
\end{frame}


\begin{frame}
  \frametitle{Residuals}
  \begin{itemize}
    \item[] $\hat{y} = mx + b$. 
      \vspace{0.5cm}
    \item[] $e = y - \hat{y}$. 
      \vspace{0.5cm}
    \item[] $e_1, e_2, \ldots, e_n$. 
  \end{itemize}
\end{frame}

