            };
            \addplot+ [
              black,
              mark=|
              sharp plot,
            ]
            coordinates { (0,0) (60,60) };
          \end{axis}
        \end{tikzpicture}
      </latex-image>
    </image>
  </figure>
  <figure xml:id="figure-residual-plot3">
    <caption>A matching residual plot</caption>
    <image xml:id="image-residual-plot3" width="80%">
      <latex-image>
        \begin{tikzpicture}
          \begin{axis}[
            xlabel={x},
            ylabel={y},
            ]
            \addplot+ [only marks] table[
              x=var1,
              y=residual,
              col sep=comma,
              row sep=crcr 
            ] {
              var1,residual\\
              2,-1.8\\
              3,-0.5\\
              5,-0.8\\
              8,-3\\
              11,0.3\\
              15,2.3\\
              16,1.7\\
              17,1.2\\
              21,2.9\\
              25,2\\
              32,1.3\\
              33,1\\
              34,1.2\\
              37,0.1\\
              41,0\\
              42,-1.2\\
              49,-1.9\\
              52,-1\\
              56,-1.7\\
            };
            \addplot+ [
              black,
              mark=|
              sharp plot,
            ]
            coordinates { (0,0) (60,0) };
          \end{axis}
        \end{tikzpicture}
      </latex-image>
    </image>
  </figure>
  <p>
    This residual plot is a bit different. There seems to be a pattern
    to the residuals: starting below, then moving above, then moving
    below. In the original scatterplot, the variance of the data from
    the line was difficult to read, visually. Here, the residual plot
    makes that much easier to read. This is the strength of a residual
    plot: it zooms in on the relationship between the data and the
    line, and can clearly show things that were present in the
    original scatterplot but were much harder to see. In this case, the
    relationship is still close to linear, but this pattern means that
    there is probably something else going on here as well, something
    non-linear between the two variables.
  </p>
</section>
